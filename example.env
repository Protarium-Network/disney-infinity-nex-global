# Games to run, comma separated. Unset = every game below, all at once.
# GAMES=disney-infinity-1.0,disney-infinity-3.0

# Each game has its own prefix, access key (version/*.go) and default ports:
#   Disney Infinity 1.0  PN_DSI1_*  UDP 29100 (auth) / 29101 (secure)
#   Disney Infinity 3.0  PN_DSI3_*  UDP 29200 (auth) / 29201 (secure)
# Ports can be overridden with PN_DSIx_AUTH_PORT / PN_DSIx_SECURE_PORT, but two
# games must never share a port.

# Host the clients are told to reach the secure server on. Keep it SHORT (the
# retail binary truncates it to ~15 chars): a bare LAN IP or hostname.
PN_DSI1_SECURE_HOST=localhost
PN_DSI3_SECURE_HOST=localhost

# One database per game (matchmaking tables would otherwise be shared).
PN_DSI1_POSTGRES_URI=postgres://postgres:password@localhost:5432/dsi1?sslmode=disable
PN_DSI3_POSTGRES_URI=postgres://postgres:password@localhost:5432/dsi3?sslmode=disable

PN_DSI1_KERBEROS_PASSWORD=change-me-1
PN_DSI3_KERBEROS_PASSWORD=change-me-3

# 1 = isolated preservation mode: accounts come from settings.json and login
#     tokens are NOT validated. Never use on a public server.
PN_DSI1_LOCAL_MODE=1
PN_DSI3_LOCAL_MODE=1
PN_DSI1_SETTINGS_PATH=settings.json
PN_DSI3_SETTINGS_PATH=settings.json

# Required for a game only when its LOCAL_MODE is not 1 (account server):
#   PN_DSIx_NEX_TOKEN_AES_KEY   64 hex chars (AES-256)
#   PN_DSIx_NEX_PASSWORD_SECRET >= 32 bytes, hex
# PN_DSI1_NEX_TOKEN_AES_KEY=
# PN_DSI1_NEX_PASSWORD_SECRET=
# PN_DSI3_NEX_TOKEN_AES_KEY=
# PN_DSI3_NEX_PASSWORD_SECRET=

# --- Companion HTTP server (go run ./http) ---
HTTP_PORT=8081
# HTTP_POSTGRES_URI=postgres://postgres:password@localhost:5432/dsi1?sslmode=disable
